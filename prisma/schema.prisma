generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id            String    @id @default(cuid())
  userId        String    @unique
  email         String
  name          String?
  createdAt     DateTime  @default(now())
  searches      SearchQuery[]
  templates     EmailTemplate[]
}

model SearchQuery {
  id            String    @id @default(cuid())
  userId        String
  user          Account   @relation(fields: [userId], references: [id])
  prompt        String    @db.Text
  intent        String?   // business | job | partnership
  filters       Json      // {geo, budgetMin, budgetMax, workType, radius, industries}
  status        String    @default("pending")
  resultCount   Int       @default(0)
  avgScore      Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  results       Result[]
}

model Result {
  id            String    @id @default(cuid())
  searchId      String
  search        SearchQuery @relation(fields: [searchId], references: [id], onDelete: Cascade)
  name          String
  type          String    // business | person | job | corporation
  description   String?   @db.Text
  website       String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  matchScore    Int       @default(0)
  matchReason   String?   @db.Text
  source        String
  sourceUrl     String?
  contacts      Contact[]
  rawData       Json?
  enriched      Boolean   @default(false)
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  refreshedAt   DateTime  @default(now())
}

model Contact {
  id            String    @id @default(cuid())
  resultId      String
  result        Result    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  email         String?
  linkedin      String?
  isPrimary     Boolean   @default(false)
}

model EmailTemplate {
  id            String    @id @default(cuid())
  userId        String
  user          Account   @relation(fields: [userId], references: [id])
  name          String
  subject       String
  body          String    @db.Text
  approachType  String    // pas | partnership | job | custom
  variables     String[]
  isWinner      Boolean   @default(false)  // archived winning template
  winCount      Int       @default(0)
  createdAt     DateTime  @default(now())
}

model OutreachEvent {
  id            String    @id @default(cuid())
  resultId      String
  templateId    String
  segment       String    @default("pas")  // pas | partnership | job | custom
  variantIndex  Int       @default(0)      // 0=A, 1=B, 2=C
  toEmails      String[]                   // multi-recipient log
  subject       String
  body          String    @db.Text
  status        String    @default("draft") // draft | sent | opened | replied | bounced | meeting_booked
  sentiment     String?                    // interested | neutral | rejection | meeting_booked
  sentAt        DateTime?
  followUpSentAt DateTime?
  createdAt     DateTime  @default(now())
}

// Cached company intelligence — avoid re-scraping same domain
model CompanyMemory {
  id            String    @id @default(cuid())
  domain        String    @unique
  companyName   String
  industry      String?
  techStack     String?
  recentNews    String?   @db.Text
  hiringStatus  String?
  fundingStage  String?
  rawFacts      String?   @db.Text  // free-form facts injected into AI prompt
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Per-user sender profile (static signature / SMTP config)
model SenderProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  fullName      String
  title         String?
  phone         String?
  linkedinUrl   String?
  calendarUrl   String?   // Calendly etc
  senderCompany String?
  signatureHtml String?   @db.Text
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassEnc   String?   // encrypted; server-side only
  fromAlias     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
